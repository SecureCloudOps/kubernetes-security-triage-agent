{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/scan-report.schema.json",
  "title": "Kubernetes Security Scan Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scan_status",
    "target",
    "collector_status",
    "analyzer_status",
    "findings",
    "attack_paths",
    "ai_status",
    "evidence_gaps",
    "summary"
  ],
  "properties": {
    "scan_status": { "enum": ["COMPLETE", "PARTIAL"] },
    "target": { "$ref": "#/$defs/target" },
    "collector_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload",
        "security_context",
        "exposure",
        "network_policy",
        "rbac",
        "trivy"
      ],
      "properties": {
        "workload": { "$ref": "#/$defs/collectorStatus" },
        "security_context": { "$ref": "#/$defs/collectorStatus" },
        "exposure": { "$ref": "#/$defs/collectorStatus" },
        "network_policy": { "$ref": "#/$defs/collectorStatus" },
        "rbac": { "$ref": "#/$defs/collectorStatus" },
        "trivy": { "$ref": "#/$defs/collectorStatus" }
      }
    },
    "analyzer_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "security_context",
        "exposure",
        "network_policy",
        "rbac",
        "trivy"
      ],
      "properties": {
        "security_context": { "$ref": "#/$defs/analyzerStatus" },
        "exposure": { "$ref": "#/$defs/analyzerStatus" },
        "network_policy": { "$ref": "#/$defs/analyzerStatus" },
        "rbac": { "$ref": "#/$defs/analyzerStatus" },
        "trivy": { "$ref": "#/$defs/analyzerStatus" }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "attack_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/attackPath" }
    },
    "ai_status": {
      "enum": ["DISABLED", "SKIPPED", "SUCCESS", "FAILED"]
    },
    "ai_analysis": { "$ref": "#/$defs/aiAnalysis" },
    "ai_error": { "$ref": "#/$defs/aiError" },
    "evidence_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceGap" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low", "info"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "scan_status": { "const": "COMPLETE" } },
        "required": ["scan_status"]
      },
      "then": {
        "properties": {
          "evidence_gaps": { "maxItems": 0 },
          "collector_status": {
            "properties": {
              "workload": { "const": "COMPLETE" },
              "security_context": { "const": "COMPLETE" },
              "exposure": { "const": "COMPLETE" },
              "network_policy": { "const": "COMPLETE" },
              "rbac": { "const": "COMPLETE" },
              "trivy": { "const": "COMPLETE" }
            }
          },
          "analyzer_status": {
            "properties": {
              "security_context": { "const": "COMPLETE" },
              "exposure": { "const": "COMPLETE" },
              "network_policy": { "const": "COMPLETE" },
              "rbac": { "const": "COMPLETE" },
              "trivy": { "const": "COMPLETE" }
            }
          }
        }
      },
      "else": {
        "properties": { "evidence_gaps": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "ai_status": { "const": "SUCCESS" } },
        "required": ["ai_status"]
      },
      "then": {
        "required": ["ai_analysis"],
        "properties": {
          "ai_analysis": { "$ref": "#/$defs/aiAnalysis" }
        },
        "not": { "required": ["ai_error"] }
      }
    },
    {
      "if": {
        "properties": { "ai_status": { "const": "FAILED" } },
        "required": ["ai_status"]
      },
      "then": {
        "required": ["ai_error"],
        "properties": {
          "ai_error": { "$ref": "#/$defs/aiError" }
        },
        "not": { "required": ["ai_analysis"] }
      }
    },
    {
      "if": {
        "properties": {
          "ai_status": { "enum": ["DISABLED", "SKIPPED"] }
        },
        "required": ["ai_status"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["ai_analysis"] },
            { "required": ["ai_error"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "collectorStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "INSUFFICIENT_EVIDENCE",
        "COLLECTION_FAILED"
      ]
    },
    "analyzerStatus": { "enum": ["COMPLETE", "ANALYSIS_FAILED"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster", "namespace", "kind", "name", "container"],
      "properties": {
        "cluster": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "container": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observed_at", "collector_version", "details"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "collector_version": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "title",
        "status",
        "severity",
        "score",
        "confidence",
        "target",
        "evidence",
        "risk_factors",
        "recommendations"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^KSA-[0-9a-fA-F]{12}$"
        },
        "title": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "CONFIRMED",
            "INSUFFICIENT_EVIDENCE",
            "COLLECTION_FAILED",
            "ANALYSIS_FAILED"
          ]
        },
        "severity": {
          "enum": ["critical", "high", "medium", "low", "info"]
        },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "target": { "$ref": "#/$defs/target" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "risk_factors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "attack_path": { "type": ["string", "null"] },
        "blast_radius": { "type": ["string", "null"] },
        "recommendations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "attackPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attack_path_id",
        "status",
        "title",
        "score",
        "severity",
        "supporting_finding_ids",
        "risk_factors",
        "explanation",
        "limitations"
      ],
      "properties": {
        "attack_path_id": {
          "type": "string",
          "pattern": "^KAP-[0-9a-f]{12}$"
        },
        "status": { "const": "PLAUSIBLE" },
        "title": { "type": "string", "minLength": 1 },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "severity": { "const": "high" },
        "supporting_finding_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^KSA-[0-9a-fA-F]{12}$"
          }
        },
        "risk_factors": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "explanation": { "type": "string", "minLength": 1 },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "aiAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executive_summary",
        "attack_path_explanations",
        "priority_order",
        "remediation_steps",
        "operator_review_notes",
        "limitations"
      ],
      "properties": {
        "executive_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "attack_path_explanations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attack_path_id", "explanation"],
            "properties": {
              "attack_path_id": {
                "type": "string",
                "pattern": "^KAP-[0-9a-f]{12}$"
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              }
            }
          }
        },
        "priority_order": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "reference_type",
              "reference_id",
              "rationale"
            ],
            "properties": {
              "position": { "type": "integer", "minimum": 1, "maximum": 200 },
              "reference_type": { "enum": ["finding", "attack_path"] },
              "reference_id": {
                "type": "string",
                "pattern": "^(KSA-[0-9a-fA-F]{12}|KAP-[0-9a-f]{12})$"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        },
        "remediation_steps": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/aiReferencedStep" }
        },
        "operator_review_notes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["finding_ids", "attack_path_ids", "note"],
            "properties": {
              "finding_ids": { "$ref": "#/$defs/findingIds" },
              "attack_path_ids": { "$ref": "#/$defs/attackPathIds" },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "aiError": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "code", "message"],
          "properties": {
            "stage": { "const": "configuration" },
            "code": { "const": "CONFIGURATION_FAILED" },
            "message": { "const": "AI analysis configuration failed." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "code", "message"],
          "properties": {
            "stage": { "const": "api" },
            "code": { "const": "API_FAILED" },
            "message": { "const": "AI API request failed." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "code", "message", "reason"],
          "properties": {
            "stage": { "const": "response" },
            "code": { "const": "INCOMPLETE_RESPONSE" },
            "message": { "const": "Model response was incomplete." },
            "reason": {
              "enum": ["max_output_tokens", "content_filter", "unknown"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "code", "message"],
          "properties": {
            "stage": { "const": "schema" },
            "code": { "const": "SCHEMA_VALIDATION_FAILED" },
            "message": { "const": "Model response failed schema validation." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "code", "message"],
          "properties": {
            "stage": { "const": "reference" },
            "code": { "const": "REFERENCE_VALIDATION_FAILED" },
            "message": {
              "const": "Model response referenced unknown or invalid evidence."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "code", "message"],
          "properties": {
            "stage": { "const": "safety" },
            "code": { "const": "SAFETY_VALIDATION_FAILED" },
            "message": { "const": "Model response failed safety validation." }
          }
        }
      ]
    },
    "aiReferencedStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_ids", "attack_path_ids", "step"],
      "properties": {
        "finding_ids": { "$ref": "#/$defs/findingIds" },
        "attack_path_ids": { "$ref": "#/$defs/attackPathIds" },
        "step": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "findingIds": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^KSA-[0-9a-fA-F]{12}$"
      }
    },
    "attackPathIds": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^KAP-[0-9a-f]{12}$"
      }
    },
    "evidenceGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "stage", "status", "errors"],
      "properties": {
        "component": {
          "enum": [
            "security_context",
            "exposure",
            "network_policy",
            "rbac",
            "trivy"
          ]
        },
        "stage": { "enum": ["COLLECTION", "ANALYSIS"] },
        "status": {
          "enum": [
            "PARTIAL",
            "INSUFFICIENT_EVIDENCE",
            "COLLECTION_FAILED",
            "ANALYSIS_FAILED"
          ]
        },
        "errors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
